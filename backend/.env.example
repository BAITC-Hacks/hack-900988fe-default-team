PORT=3388
DATABASE_URL=file:./dev.db
FRONTEND_ORIGIN=https://haa.defaul7.net
API_BASE_URL=https://haa-api.defaul7.net/api
REQUEST_LOGGING=true

# OpenAI-совместимый провайдер. Пустой адрес отключает LLM.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_PATH=/chat/completions

# Реальный ключ указывается только в локальном .env.
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-coder-next

# Необязательно: отдельная модель анализа.
# Если пусто, используется LLM_MODEL.
LLM_MODEL_ANALYSIS=

# Зарезервированы; текущий backend не использует.
LLM_MODEL_CHAT=
LLM_MODEL_PLAN=

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60
LLM_EXTRA_HEADERS={"HTTP-Referer":"https://haa.defaul7.net","X-Title":"HackAlem AI"}
